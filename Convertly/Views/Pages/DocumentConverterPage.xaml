<Page x:Class="Convertly.Views.Pages.DocumentConverterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Convertly.Views.Pages"
      xmlns:fa="http://schemas.fontawesome.com/icons/"
      mc:Ignorable="d" 
      Background="#FF282C34"
      FontFamily="Bahnschrift SemiBold SemiCondensed"
      Foreground="White"
      d:DesignHeight="730" d:DesignWidth="1300"
      Title="DocumentConverterPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="1"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" HorizontalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Область перетаскивания -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="10" VerticalAlignment="Top">
                <TextBlock Text="Перетащите файл" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Button Content="Выберите файл" Margin="5" Template="{StaticResource ControlButton}"/>
            </StackPanel>

            <!-- Кнопки управления -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="10" VerticalAlignment="Bottom">
                <Button Content="Конверт. и сохр." Margin="5" Template="{StaticResource ControlButton}"/>
                <Button Content="Удалить" Margin="5" Template="{StaticResource ControlButton}"/>
            </StackPanel>

            <ListView Grid.RowSpan="2" Grid.Column="1" FontSize="15" ItemsSource="{Binding FileList}" BorderThickness="0" Background="#FF282C34" Foreground="White" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="2" Width="550" BorderBrush="White">

                            <StackPanel Orientation="Horizontal" Margin="10">

                                <StackPanel Margin="10">
                                    <Image Width="100" Height="100" Source="{Binding FileUri}"/>
                                </StackPanel>

                                <StackPanel Orientation="Vertical" Margin="10">

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Название файла: "/>
                                        <TextBlock Text="{Binding FileName}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Размер файла в КБ: "/>
                                        <TextBlock Text="{Binding FileSize}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Тип файла: "/>
                                        <TextBlock Text="{Binding FileType}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Тип файла: "/>
                                        <TextBlock Text="{Binding FileType}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Размер файла в КБ: "/>
                                        <TextBlock Text="{Binding FileSize}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Тип файла: "/>
                                        <TextBlock Text="{Binding FileType}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Тип файла: "/>
                                        <TextBlock Text="{Binding FileType}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </DataTemplate>

                </ListView.ItemTemplate>
            </ListView>

        </Grid>
        
    </Grid>

